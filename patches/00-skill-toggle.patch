index 0000000..973d17c
--- /dev/null
+++ b/packages/tui/src/component/dialog-skill-uninstall.tsx
@@ -0,0 +1,59 @@
+import { spawn } from "node:child_process"
+import os from "node:os"
+import path from "node:path"
+import { useExit } from "../context/exit"
+import { useDialog } from "../ui/dialog"
+import { DialogSelect } from "../ui/dialog-select"
+
+type Choice = "restore" | "remove" | "cancel"
+
+export function DialogSkillUninstall() {
+  const exit = useExit()
+  const dialog = useDialog()
+
+  // The uninstaller has to run after this process releases the binary (on
+  // Windows a running .exe cannot be replaced), so it is detached and delayed.
+  const launch = (purge: boolean) => {
+    const home = os.homedir()
+    const script = path.join(home, ".opencode", process.platform === "win32" ? "toggle-uninstall.ps1" : "toggle-uninstall.sh")
+    const options = { detached: true, stdio: "ignore" as const, cwd: home }
+    if (process.platform === "win32") {
+      const args = ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", script, "-Yes"]
+      if (purge) args.push("-Purge")
+      spawn("powershell.exe", args, options).unref()
+    } else {
+      const args = purge ? ["--yes", "--purge"] : ["--yes"]
+      spawn("bash", ["-c", 'sleep 1; exec bash "$0" "$@"', script, ...args], options).unref()
+    }
+    dialog.clear()
+    exit()
+  }
+
+  return (
+    <DialogSelect<Choice>
+      title="Uninstall skill-toggle"
+      options={[
+        {
+          value: "cancel",
+          title: "Cancel",
+          description: "Leave everything as it is (default)",
+        },
+        {
+          value: "restore",
+          title: "Restore official opencode",
+          description: "Remove the toggle patch and keep your sessions and settings",
+        },
+        {
+          value: "remove",
+          title: "Remove opencode completely",
+          description: "Delete the binary, guard and scripts; conversation data is kept",
+        },
+      ]}
+      onSelect={(option) => {
+        if (option.value === "restore") return launch(false)
+        if (option.value === "remove") return launch(true)
+        dialog.clear()
+      }}
+    />
+  )
+}
