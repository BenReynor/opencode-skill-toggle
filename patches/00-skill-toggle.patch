+import { createMemo, createSignal } from "solid-js"
+import { useLocal } from "../context/local"
+import { useSync } from "../context/sync"
+import { map, pipe, entries, sortBy } from "remeda"
+import { DialogSelect, type DialogSelectRef, type DialogSelectOption } from "../ui/dialog-select"
+import { useTheme, selectedForeground } from "../context/theme"
+import { TextAttributes } from "@opentui/core"
+import { useSDK } from "../context/sdk"
+
+function Status(props: { enabled: boolean; loading: boolean; active: () => boolean }) {
+  const { theme } = useTheme()
+  const fg = selectedForeground(theme)
+  if (props.loading) {
+    return <span style={{ fg: props.active() ? fg : theme.textMuted }}>⋯ Loading</span>
+  }
+  if (props.enabled) {
+    return <span style={{ fg: props.active() ? fg : theme.success, attributes: TextAttributes.BOLD }}>✓ Enabled</span>
+  }
+  return <span style={{ fg: props.active() ? fg : theme.textMuted }}>○ Disabled</span>
+}
+
+export function DialogSkillToggle() {
+  const local = useLocal()
+  const sync = useSync()
+  const sdk = useSDK()
+  const [, setRef] = createSignal<DialogSelectRef<unknown>>()
+  const [loading, setLoading] = createSignal<string | null>(null)
+  const [active, setActive] = createSignal<string>()
+
+  const options = createMemo(() => {
+    const skillData = sync.data.skill
+    const loadingSkill = loading()
+
+    return pipe(
+      skillData ?? {},
+      entries(),
+      sortBy(([name]) => name),
+      map(([name, enabled]) => ({
+        value: name,
+        title: name,
+        description: enabled ? "active" : "inactive",
+        footer: (
+          <Status enabled={local.skill.isEnabled(name)} loading={loadingSkill === name} active={() => active() === name} />
+        ),
+        category: undefined,
+      })),
+    )
+  })
+
+  const actions = createMemo(() => [
+    {
+      command: "dialog.skill.toggle",
+      title: "toggle",
+      onTrigger: async (option: DialogSelectOption<string>) => {
+        if (loading() !== null) return
+
+        setLoading(option.value)
+        try {
+          await local.skill.toggle(option.value)
+          // Refresh skill status from server
+          const status = await sdk.client.skill.status()
+          if (status.data) {
+            sync.set("skill", status.data)
+          } else {
+            console.error("Failed to refresh skill status: no data returned")
+          }
+        } catch (error) {
+          console.error("Failed to toggle skill:", error)
+        } finally {
+          setLoading(null)
+        }
+      },
+    },
+  ])
+
+  return (
+    <DialogSelect
+      ref={setRef}
+      title="Skills"
+      options={options()}
+      actions={actions()}
+      onMove={(option) => setActive(option.value)}
+      onSelect={(_option) => {
+        // Don't close on select, only on escape
+      }}
+    />
+  )
+}
