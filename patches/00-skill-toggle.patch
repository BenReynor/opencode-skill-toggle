@@ -0,0 +1,29 @@
+import { Skill } from "@/skill"
+import { Effect } from "effect"
+import { HttpApiBuilder } from "effect/unstable/httpapi"
+import { InstanceHttpApi } from "../api"
+
+export const skillHandlers = HttpApiBuilder.group(InstanceHttpApi, "skill", (handlers) =>
+  Effect.gen(function* () {
+    const skill = yield* Skill.Service
+
+    type Query = { session?: string }
+
+    const status = Effect.fn("SkillHttpApi.status")(function* (ctx: { query: Query }) {
+      return yield* skill.status(ctx.query.session)
+    })
+
+    const enable = Effect.fn("SkillHttpApi.enable")(function* (ctx: { params: { name: string }; query: Query }) {
+      return yield* skill.enable(ctx.params.name, ctx.query.session)
+    })
+
+    const disable = Effect.fn("SkillHttpApi.disable")(function* (ctx: { params: { name: string }; query: Query }) {
+      return yield* skill.disable(ctx.params.name, ctx.query.session)
+    })
+
+    return handlers
+      .handle("status", status)
+      .handle("enable", enable)
+      .handle("disable", disable)
+  }),
+)
