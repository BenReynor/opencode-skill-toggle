@@ -0,0 +1,27 @@
+import { Skill } from "@/skill"
+import { Effect } from "effect"
+import { HttpApiBuilder } from "effect/unstable/httpapi"
+import { InstanceHttpApi } from "../api"
+
+export const skillHandlers = HttpApiBuilder.group(InstanceHttpApi, "skill", (handlers) =>
+  Effect.gen(function* () {
+    const skill = yield* Skill.Service
+
+    const status = Effect.fn("SkillHttpApi.status")(function* () {
+      return yield* skill.status()
+    })
+
+    const enable = Effect.fn("SkillHttpApi.enable")(function* (ctx: { params: { name: string } }) {
+      return yield* skill.enable(ctx.params.name)
+    })
+
+    const disable = Effect.fn("SkillHttpApi.disable")(function* (ctx: { params: { name: string } }) {
+      return yield* skill.disable(ctx.params.name)
+    })
+
+    return handlers
+      .handle("status", status)
+      .handle("enable", enable)
+      .handle("disable", disable)
+  }),
+)
