+// Per-session skill configuration.
+//
+// Every session gets its own snapshot of which skills are enabled, so switching
+// back to an old session restores exactly what it had. New sessions start with
+// every skill disabled except the built-in one (otherwise the model could not
+// even read opencode's own configuration). Sessions that existed before this
+// format was introduced keep the global configuration they already had.
+const TOGGLE_VERSION = 2
+const TOGGLE_FILE = "skills-toggle.json"
+// Keep the file bounded: drop the least recently used sessions first.
+const TOGGLE_KEEP_SESSIONS = 500
+const BUILTIN_SKILL = CUSTOMIZE_OPENCODE_SKILL_NAME
+// Real session ids look like "ses_<alphanumerics>". Anything else is rejected so
+// arbitrary strings can never become keys of the state file.
+const SESSION_ID = /^ses_[A-Za-z0-9]+$/
